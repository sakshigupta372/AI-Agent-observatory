---
import PageTransitions from '../components/PageTransitions.astro'
import { pageMotion } from '../data/pageMotion.js'
import ObservatoryApp from '../components/ObservatoryApp.jsx'
import '../styles/global.css'
---
<html lang="en" transition:animate={pageMotion}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Observatory · AI Agent Observatory</title>
    <PageTransitions />
  </head>
  <body>
    <div class="app-root">
      <div class="title-header">
        <h1>AI AGENT OBSERVATORY</h1>
        <span>AUTONOMOUS EXECUTION VISUALIZATION</span>
      </div>

      <nav class="site-nav">
        <a href="/">Home</a>
        <a class="current" href="/observatory">Observatory</a>
        <a href="/traces">Traces</a>
        <a href="/evals">Evaluations</a>
      </nav>
      <ObservatoryApp client:only="react" />
    </div>
  </body>
</html>
