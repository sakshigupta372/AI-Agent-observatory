---
import { ClientRouter } from 'astro:transitions'
---
<ClientRouter fallback="animate" />

<style is:global>
  @keyframes obs-page-out {
    to {
      opacity: 0;
      transform: translateY(-12px) scale(0.99);
      filter: blur(4px);
    }
  }

  @keyframes obs-page-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.99);
      filter: blur(6px);
    }
  }

  ::view-transition-group(site-header),
  ::view-transition-group(page-hero) {
    animation-duration: 0.7s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  ::view-transition-old(page-hero),
  ::view-transition-new(page-hero) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .route-bar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #4373ba, #8fc0f5);
    transform-origin: left;
    transform: scaleX(0);
    opacity: 0;
    pointer-events: none;
    view-transition-name: route-bar;
  }

  .route-bar.loading {
    opacity: 1;
    transform: scaleX(0.75);
    transition: transform 6s cubic-bezier(0.1, 0.7, 0.2, 1), opacity 0.2s;
  }

  .route-bar.done {
    opacity: 0;
    transform: scaleX(1);
    transition: transform 0.25s ease-out, opacity 0.4s 0.2s;
  }
</style>

<script>
  // Lives on <html>, which the router keeps between pages, so the bar survives the swap.
  const bar = () => {
    let el = document.querySelector('.route-bar')
    if (!el) {
      el = document.createElement('div')
      el.className = 'route-bar'
      el.setAttribute('aria-hidden', 'true')
      document.documentElement.append(el)
    }
    return el
  }

  document.addEventListener('astro:before-preparation', () => {
    const el = bar()
    el.className = 'route-bar'
    void el.offsetWidth
    el.classList.add('loading')
  })

  document.addEventListener('astro:after-swap', () => {
    const el = bar()
    el.classList.remove('loading')
    el.classList.add('done')
  })
</script>
